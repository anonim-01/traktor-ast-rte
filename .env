# Flask Secret Key (üretimde mutlaka değiştirin!)
FLASK_SECRET_KEY=rastgele-uzun-bir-guvenli-anahtar-buraya

# Database Path
DATABASE_PATH=./db.sqlite3

# Frontend Encryption (true/false)
FRONTEND_ENCRYPTION_ENABLED=true

# Cloudflare Configuration
CLOUDFLARE_ACCOUNT_ID=ccf119a16f7abfd37a26efe65e4a1077
CLOUDFLARE_API_TOKEN=yeni-token-buraya

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=false

# IP Blocker Configuration
BLOCKED_IPS=
BLOCKED_RANGES=

# Session Configuration
SESSION_TYPE=filesystem
SESSION_PERMANENT=false
SESSION_USE_SIGNER=true
PERMANENT_SESSION_LIFETIME=3600

# Logging
LOG_LEVEL=INFO